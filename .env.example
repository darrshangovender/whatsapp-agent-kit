# WhatsApp Cloud API (Meta for Developers → your app → WhatsApp → API Setup)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# App secret used to verify the X-Hub-Signature-256 header on inbound webhooks
WA_APP_SECRET=
# Any string you choose; paste the same value into the Meta webhook config
WA_VERIFY_TOKEN=change-me

# Optional
WA_API_VERSION=v20.0
WA_DB_PATH=./data/wa_kit.db
WA_TIMEZONE=Africa/Johannesburg
# POST escalations here (Slack incoming webhook, your CRM, ...). Empty = log only.
WA_ESCALATION_WEBHOOK=
